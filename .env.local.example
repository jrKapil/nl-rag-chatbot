# ============================================================
# Mutual Fund FAQ RAG Chatbot — environment variables
# Copy: cp .env.local.example .env.local   (then fill in values)
# For web/: cp .env.local.example web/.env.local
# NEVER commit the real .env.local (gitignored).
# ============================================================

# --- Groq (generation LLM) ---
# Get: https://console.groq.com/ -> API Keys
GROQ_API_KEY=
# Current Groq production text models (llama-3.x being deprecated there):
#   openai/gpt-oss-120b  (default — ~500 t/s)
#   openai/gpt-oss-20b   (fallback / cheaper)
GROQ_MODEL=openai/gpt-oss-120b

# --- Vector store (hosted): Pinecone serverless ---
# Backend switch 2026-11-08: Chroma Cloud stopped accepting new signups.
# Get key: https://app.pinecone.io -> API Keys
VECTOR_DB=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=mf-faq
PINECONE_REGION=us-east-1
PINECONE_CLOUD=aws

# --- Chroma (local dev tooling only; CHROMA_MODE=cloud now legacy) ---
# local = embedded chromadb at ./data/chroma
CHROMA_MODE=local

# --- Retrieval tuning ---
RETRIEVAL_K=4
SIM_THRESHOLD=0.35

# --- HuggingFace (query embeddings — used when transformers.js is not available) ---
# Get: https://huggingface.co/settings/tokens (free, read access)
HF_TOKEN=
