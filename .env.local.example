# ============================================================
# Mutual Fund FAQ RAG Chatbot — environment variables
# Copy: cp .env.local.example .env.local   (then fill in values)
# For web/: cp .env.local.example web/.env.local
# NEVER commit the real .env.local (gitignored).
# ============================================================

# --- Groq (generation LLM) ---
# Get: https://console.groq.com/ -> API Keys
GROQ_API_KEY=
# Current Groq production text models (llama-3.x being deprecated there):
#   openai/gpt-oss-120b  (default — ~500 t/s)
#   openai/gpt-oss-20b   (fallback / cheaper)
GROQ_MODEL=openai/gpt-oss-120b

# --- Chroma (vector store) ---
# cloud | local  (local = embedded chromadb at ./data/chroma — dev default)
CHROMA_MODE=local
# Required when CHROMA_MODE=cloud (Signup: https://trychroma.com)
# NOTE: Vercel read-only key, dev machine ingest key (ARCHITECTURE §11)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# --- Retrieval tuning ---
RETRIEVAL_K=4
SIM_THRESHOLD=0.35
